# Reference for the env vars the app reads. The setup wizard generates a
# real .env (or .env.<flavor> per flavor) containing only the keys for the
# integrations you enabled — this file lists every possible key.

# Supabase (required)
# SUPABASE_URL is the API URL (https://<ref>.supabase.co) — NOT the
# dashboard URL (https://supabase.com/dashboard/project/<ref>).
SUPABASE_URL=https://your-project.supabase.co
# Use the publishable key — Project Settings -> API Keys -> Publishable key
# (starts with sb_publishable_...) — not the legacy anon/JWT key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# OneSignal (optional)
# ONESIGNAL_APP_ID=your-onesignal-app-id

# RevenueCat (optional)
# REVENUECAT_IOS_API_KEY=appl_your-ios-key
# REVENUECAT_ANDROID_API_KEY=goog_your-android-key
# REVENUECAT_TEST_MODE=true

# Stripe (optional)
# STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# Sentry (optional)
# SENTRY_DSN=https://your-dsn@sentry.io/your-project

# PowerSync (optional)
# POWERSYNC_URL=https://your-instance.powersync.journeyapps.com

# Custom backend API (optional)
# API_BASE_URL=https://api.your-app.com
